    int i = 0;
    while (!(var & mask)) {
        mask = 0x01;
        mask = mask << i;
        i = i + 1;
    }

    //i == 3
    mask = 0x01;
    mask = mask << i; //1000
    //0100
    //1000
    //1100
    //
    
    return 0;
}