#include <stdio.h>

int main(void)
{
    int var = 0x34; //0011 0100
    //find the first set bit --> position : 2 and toggle the position 3 bit

    int mask = 0x01;

    //0100
    //0001 &
    //0
    //0010 << shift by 1, shft by 2
    //0100
